# Used by `npm run build:pages` (GitHub Pages deploy).

# Switches the public viewer from live API calls to the pre-exported static
# JSON under public/data/ (see server/src/scripts/exportStatic.ts).
VITE_DATA_MODE=static

# Switches the admin panel from the Express backend to direct GitHub commits,
# authenticated with a personal access token the admin pastes in at
# /admin/login (see README: "Fully GitHub-native admin"). Set to `express`
# instead if you'd rather ship a read-only viewer with no working admin on
# GitHub Pages, and keep editing only through the local backend.
VITE_ADMIN_MODE=github
VITE_GITHUB_OWNER=kankan-chadash
VITE_GITHUB_REPO=-
VITE_GITHUB_BRANCH=main
